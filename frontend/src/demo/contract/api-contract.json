{
  "routes": {
    "/health": ["GET"],
    "/api/status": ["GET"],
    "/api/containers": ["GET"],
    "/api/containers/{container_id}": ["GET"],
    "/api/containers/select": ["POST"],
    "/api/containers/{container_id}/restart": ["POST"],
    "/api/containers/{container_id}/unquarantine": ["POST"],
    "/api/maintenance/enable": ["POST"],
    "/api/maintenance/disable": ["POST"],
    "/api/maintenance/status": ["GET"],
    "/api/config": ["GET", "PUT"],
    "/api/config/monitor": ["PUT"],
    "/api/config/restart": ["PUT"],
    "/api/config/export": ["GET"],
    "/api/config/import": ["POST"],
    "/api/config/observability": ["PUT"],
    "/api/healthchecks": ["GET", "POST"],
    "/api/healthchecks/{container_id}": ["DELETE", "GET"],
    "/api/events": ["DELETE", "GET"],
    "/api/uptime-kuma/test-connection": ["POST"],
    "/api/uptime-kuma/enable": ["POST"],
    "/api/uptime-kuma/monitors": ["GET"],
    "/api/uptime-kuma/mappings": ["GET", "POST"],
    "/api/uptime-kuma/mappings/{container_id}": ["DELETE"],
    "/api/uptime-kuma/disable": ["POST"],
    "/api/notifications/config": ["GET", "PUT"],
    "/api/notifications/services": ["POST"],
    "/api/notifications/services/{service_name}": ["DELETE", "PUT"],
    "/api/notifications/test": ["POST"],
    "/api/notifications/test/{service_name}": ["POST"]
  },
  "models": {
    "ContainerInfo": [
      "id",
      "name",
      "image",
      "status",
      "state",
      "labels",
      "health",
      "restart_count",
      "monitored",
      "quarantined",
      "uptime_kuma_status",
      "uptime_kuma_monitor_name"
    ],
    "SystemStatus": [
      "monitoring_active",
      "docker_connected",
      "total_containers",
      "monitored_containers",
      "quarantined_containers",
      "maintenance_mode",
      "maintenance_start_time",
      "config"
    ]
  }
}
