{
  "$defs": {
    "AlertsConfig": {
      "description": "Alerting configuration",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable alerts",
          "title": "Enabled",
          "type": "boolean"
        },
        "webhook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL for alerts",
          "title": "Webhook"
        },
        "notify_on_quarantine": {
          "default": true,
          "description": "Send alert when container is quarantined",
          "title": "Notify On Quarantine",
          "type": "boolean"
        }
      },
      "title": "AlertsConfig",
      "type": "object"
    },
    "BackoffConfig": {
      "description": "Restart backoff configuration",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable exponential backoff",
          "title": "Enabled",
          "type": "boolean"
        },
        "initial_seconds": {
          "default": 10,
          "description": "Initial backoff delay in seconds",
          "minimum": 1,
          "title": "Initial Seconds",
          "type": "integer"
        },
        "multiplier": {
          "default": 2.0,
          "description": "Backoff multiplier",
          "minimum": 1.0,
          "title": "Multiplier",
          "type": "number"
        },
        "max_seconds": {
          "default": 300,
          "description": "Maximum backoff delay in seconds",
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "title": "BackoffConfig",
      "type": "object"
    },
    "ContainersConfig": {
      "description": "Container selection configuration",
      "properties": {
        "selected": {
          "description": "Explicitly selected container IDs/names",
          "items": {
            "type": "string"
          },
          "title": "Selected",
          "type": "array"
        },
        "excluded": {
          "description": "Explicitly excluded container IDs/names",
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "restart_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Restart counts by stable_id",
          "title": "Restart Counts",
          "type": "object"
        },
        "restart_history": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "description": "Restart timestamps (epoch seconds) by recovery id, used for the max_restarts_window_seconds rolling window",
          "title": "Restart History",
          "type": "object"
        }
      },
      "title": "ContainersConfig",
      "type": "object"
    },
    "FiltersConfig": {
      "description": "Filtering rules for containers",
      "properties": {
        "whitelist_names": {
          "description": "Container name patterns to whitelist",
          "items": {
            "type": "string"
          },
          "title": "Whitelist Names",
          "type": "array"
        },
        "blacklist_names": {
          "description": "Container name patterns to blacklist",
          "items": {
            "type": "string"
          },
          "title": "Blacklist Names",
          "type": "array"
        },
        "whitelist_labels": {
          "description": "Label filters to whitelist",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Whitelist Labels",
          "type": "array"
        },
        "blacklist_labels": {
          "description": "Label filters to blacklist",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Blacklist Labels",
          "type": "array"
        }
      },
      "title": "FiltersConfig",
      "type": "object"
    },
    "MonitorConfig": {
      "description": "Monitor configuration settings",
      "properties": {
        "interval_seconds": {
          "default": 30,
          "description": "Monitoring interval in seconds",
          "minimum": 1,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "label_key": {
          "default": "autoheal",
          "description": "Label key to filter containers",
          "title": "Label Key",
          "type": "string"
        },
        "label_value": {
          "default": "true",
          "description": "Label value to filter containers",
          "title": "Label Value",
          "type": "string"
        },
        "include_all": {
          "default": false,
          "description": "Monitor all containers regardless of labels",
          "title": "Include All",
          "type": "boolean"
        }
      },
      "title": "MonitorConfig",
      "type": "object"
    },
    "NotificationService": {
      "description": "Notification service configuration",
      "properties": {
        "name": {
          "description": "Service name (for identification)",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Service type: webhook, discord, slack, telegram, ntfy, gotify, pushover",
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Enable this notification service",
          "title": "Enabled",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL (webhook, discord, slack)",
          "title": "Url"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom headers for webhook",
          "title": "Headers"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Username (discord, ntfy)",
          "title": "Username"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Password (ntfy)",
          "title": "Password"
        },
        "bot_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Telegram bot token",
          "title": "Bot Token"
        },
        "chat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Telegram chat ID",
          "title": "Chat Id"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ntfy topic",
          "title": "Topic"
        },
        "server_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ntfy server URL (default: https://ntfy.sh)",
          "title": "Server Url"
        },
        "access_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ntfy access token (takes precedence over username/password)",
          "title": "Access Token"
        },
        "app_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gotify app token",
          "title": "App Token"
        },
        "user_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pushover user key",
          "title": "User Key"
        },
        "api_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pushover API token",
          "title": "Api Token"
        }
      },
      "required": ["name", "type"],
      "title": "NotificationService",
      "type": "object"
    },
    "NotificationsConfig": {
      "description": "Notifications configuration",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable notification system",
          "title": "Enabled",
          "type": "boolean"
        },
        "services": {
          "description": "List of notification services",
          "items": {
            "$ref": "#/$defs/NotificationService"
          },
          "title": "Services",
          "type": "array"
        },
        "event_filters": {
          "description": "Event types to send notifications for (empty = all events)",
          "items": {
            "type": "string"
          },
          "title": "Event Filters",
          "type": "array"
        }
      },
      "title": "NotificationsConfig",
      "type": "object"
    },
    "ObservabilityConfig": {
      "description": "Observability and metrics configuration",
      "properties": {
        "prometheus_enabled": {
          "default": true,
          "description": "Enable Prometheus metrics",
          "title": "Prometheus Enabled",
          "type": "boolean"
        },
        "metrics_port": {
          "default": 9090,
          "description": "Metrics endpoint port",
          "maximum": 65535,
          "minimum": 1,
          "title": "Metrics Port",
          "type": "integer"
        },
        "log_format": {
          "default": "json",
          "description": "Log format: json or text",
          "title": "Log Format",
          "type": "string"
        },
        "log_level": {
          "default": "INFO",
          "description": "Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "RestartConfig": {
      "description": "Restart policy configuration",
      "properties": {
        "mode": {
          "default": "on-failure",
          "description": "Restart mode: on-failure, health, or both",
          "title": "Mode",
          "type": "string"
        },
        "cooldown_seconds": {
          "default": 60,
          "description": "Cooldown between restarts",
          "minimum": 0,
          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "max_restarts": {
          "default": 3,
          "description": "Maximum restarts within window",
          "minimum": 1,
          "title": "Max Restarts",
          "type": "integer"
        },
        "max_restarts_window_seconds": {
          "default": 600,
          "description": "Time window for max restarts",
          "minimum": 1,
          "title": "Max Restarts Window Seconds",
          "type": "integer"
        },
        "backoff": {
          "$ref": "#/$defs/BackoffConfig"
        },
        "respect_manual_stop": {
          "default": true,
          "description": "Respect manual container stops (exit code 0)",
          "title": "Respect Manual Stop",
          "type": "boolean"
        }
      },
      "title": "RestartConfig",
      "type": "object"
    },
    "UIConfig": {
      "description": "UI configuration settings",
      "properties": {
        "enable": {
          "default": true,
          "description": "Enable web UI",
          "title": "Enable",
          "type": "boolean"
        },
        "listen_address": {
          "default": "0.0.0.0",
          "description": "UI listen address",
          "title": "Listen Address",
          "type": "string"
        },
        "listen_port": {
          "default": 3131,
          "description": "UI listen port",
          "maximum": 65535,
          "minimum": 1,
          "title": "Listen Port",
          "type": "integer"
        },
        "allow_export_json": {
          "default": true,
          "description": "Allow configuration export",
          "title": "Allow Export Json",
          "type": "boolean"
        },
        "allow_import_json": {
          "default": true,
          "description": "Allow configuration import",
          "title": "Allow Import Json",
          "type": "boolean"
        },
        "max_log_entries": {
          "default": 50,
          "description": "Maximum log entries to keep in memory",
          "minimum": 1,
          "title": "Max Log Entries",
          "type": "integer"
        }
      },
      "title": "UIConfig",
      "type": "object"
    },
    "UptimeKumaConfig": {
      "description": "Uptime-Kuma integration configuration",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable Uptime-Kuma integration",
          "title": "Enabled",
          "type": "boolean"
        },
        "server_url": {
          "default": "",
          "description": "Uptime-Kuma server URL (e.g., http://localhost:3001)",
          "title": "Server Url",
          "type": "string"
        },
        "username": {
          "default": "",
          "description": "Uptime-Kuma username (optional for API key auth)",
          "title": "Username",
          "type": "string"
        },
        "api_token": {
          "default": "",
          "description": "Uptime-Kuma API token or password",
          "title": "Api Token",
          "type": "string"
        },
        "auto_restart_on_down": {
          "default": true,
          "description": "Auto-restart container when monitor is DOWN",
          "title": "Auto Restart On Down",
          "type": "boolean"
        }
      },
      "title": "UptimeKumaConfig",
      "type": "object"
    },
    "UptimeKumaMapping": {
      "description": "Container to Uptime-Kuma monitor mapping",
      "properties": {
        "container_id": {
          "description": "Container stable ID (stable across recreations)",
          "title": "Container Id",
          "type": "string"
        },
        "monitor_friendly_name": {
          "description": "Uptime-Kuma monitor friendly name",
          "title": "Monitor Friendly Name",
          "type": "string"
        },
        "auto_mapped": {
          "default": false,
          "description": "Whether this was auto-mapped",
          "title": "Auto Mapped",
          "type": "boolean"
        }
      },
      "required": ["container_id", "monitor_friendly_name"],
      "title": "UptimeKumaMapping",
      "type": "object"
    },
    "AutoHealConfig": {
      "description": "Main auto-heal configuration",
      "properties": {
        "monitor": {
          "$ref": "#/$defs/MonitorConfig"
        },
        "containers": {
          "$ref": "#/$defs/ContainersConfig"
        },
        "restart": {
          "$ref": "#/$defs/RestartConfig"
        },
        "filters": {
          "$ref": "#/$defs/FiltersConfig"
        },
        "ui": {
          "$ref": "#/$defs/UIConfig"
        },
        "alerts": {
          "$ref": "#/$defs/AlertsConfig"
        },
        "observability": {
          "$ref": "#/$defs/ObservabilityConfig"
        },
        "uptime_kuma": {
          "$ref": "#/$defs/UptimeKumaConfig"
        },
        "uptime_kuma_mappings": {
          "items": {
            "$ref": "#/$defs/UptimeKumaMapping"
          },
          "title": "Uptime Kuma Mappings",
          "type": "array"
        },
        "notifications": {
          "$ref": "#/$defs/NotificationsConfig"
        }
      },
      "title": "AutoHealConfig",
      "type": "object"
    },
    "HealthCheckConfig": {
      "description": "Custom health check configuration for a container",
      "properties": {
        "container_id": {
          "title": "Container Id",
          "type": "string"
        },
        "check_type": {
          "description": "Type: http, tcp, exec, or docker",
          "title": "Check Type",
          "type": "string"
        },
        "interval_seconds": {
          "default": 30,
          "minimum": 1,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "retries": {
          "default": 3,
          "minimum": 1,
          "title": "Retries",
          "type": "integer"
        },
        "http_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Endpoint"
        },
        "http_expected_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 200,
          "title": "Http Expected Status"
        },
        "tcp_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tcp Port"
        },
        "exec_command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exec Command"
        }
      },
      "required": ["container_id", "check_type"],
      "title": "HealthCheckConfig",
      "type": "object"
    }
  }
}
