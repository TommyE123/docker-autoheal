{
  // Configuration for markdownlint / MegaLinter's MARKDOWN_MARKDOWNLINT.
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "default": true,

  // Line length matches the 100 characters Ruff uses for Python. Tables are
  // exempt here because MD060 governs their formatting.
  "MD013": {
    "line_length": 100,
    "heading_line_length": 100,
    "code_block_line_length": 120,
    "code_blocks": true,
    "tables": false,
    "headings": true
  },

  // Tables use aligned formatting: pipes line up vertically in the source.
  "MD060": { "style": "aligned" },

  // Docs in this repo legitimately repeat headings (e.g. the same subsection
  // name) under different parent headings - siblings_only only flags
  // duplicates under the *same* parent heading.
  "MD024": { "siblings_only": true }
}
