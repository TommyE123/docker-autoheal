{
  "name": "Docker Auto-Heal",
  "runArgs": ["--name", "docker-autoheal-devcontainer"],
  "privileged": true,
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:2@sha256:2a19d3b0b3879437637cfd292eb29fee0afcfbe6364e33db9afc4f80c5c1f956": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {},
    "ghcr.io/devcontainers/features/github-cli:1@sha256:bd7ab48a832228f633239277552c30b353867fef2e5b037e064b4e64f0b843f2": {}
  },

  "mounts": [
    "source=docker-autoheal-dind-${devcontainerId},target=/var/lib/docker,type=volume",
    "source=docker-autoheal-cache,target=/home/vscode/.cache,type=volume",
    "source=docker-autoheal-gh-cache,target=/home/vscode/.local/share/gh,type=volume",
    "source=docker-autoheal-mise-data,target=/home/vscode/.local/share/mise,type=volume"
  ],

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "waitFor": "postCreateCommand",

  "forwardPorts": [3000, 3132, 9091, 9323],

  "portsAttributes": {
    "3000": {
      "label": "Frontend"
    },
    "3132": {
      "label": "Autoheal dev stack (UI and API)"
    },
    "9091": {
      "label": "Autoheal dev stack metrics"
    },
    "9323": {
      "label": "Playwright UI"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "foxundermoon.shell-format",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "DavidAnson.vscode-markdownlint",
        "stylelint.vscode-stylelint",
        "vitest.explorer",
        "yzhang.markdown-all-in-one"
      ]
    }
  },

  "containerEnv": {
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm",
    "UV_LINK_MODE": "copy"
  },

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devcontainer/node_modules/.bin:/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}",
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/mise.toml"
  },

  "remoteUser": "vscode",
  "shutdownAction": "stopContainer"
}
